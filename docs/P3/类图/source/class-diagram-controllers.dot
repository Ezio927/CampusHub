
digraph G {
  graph [rankdir=LR, bgcolor="white", fontname="Noto Sans CJK SC", fontsize=22, labelloc="t", label="CampusHub Controller 层类图（优化版）", pad="0.45", nodesep="0.45", ranksep="0.7", splines=ortho, outputorder=edgesfirst, pack=true, packmode="array_t4", newrank=true];
  node [shape=plaintext, fontname="Noto Sans CJK SC", fontsize=12, margin=0];
  edge [fontname="Noto Sans CJK SC", fontsize=10, color="#475569", penwidth=1.25, arrowsize=0.75];
  ApiResponse [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" STYLE="ROUNDED">
  <TR><TD BGCOLOR="#E2E8F0" ALIGN="CENTER"><B>ApiResponse&lt;T&gt;</B><BR/><FONT POINT-SIZE="10">«统一响应»</FONT></TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC"><FONT POINT-SIZE="10">code: Integer<BR ALIGN="LEFT"/>message: String<BR ALIGN="LEFT"/>data: T</FONT></TD></TR>
  
</TABLE>
>];
  AuthNote [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#CBD5E1" STYLE="ROUNDED">
  <TR><TD BGCOLOR="#FEF3C7" ALIGN="CENTER"><B>统一约定</B></TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">所有鉴权接口读取 Authorization: Bearer &lt;JWT_TOKEN&gt;<BR ALIGN="LEFT"/>URL 使用小写复数名词；请求/响应字段使用 camelCase<BR ALIGN="LEFT"/>Controller 只负责参数接收、鉴权入口和统一响应</FONT></TD></TR>
</TABLE>
>];
  subgraph cluster_auth {
    label="认证接口"; fontname="Noto Sans CJK SC"; fontsize=15; color="#CBD5E1"; style="rounded,dashed"; penwidth=1.2;
    AuthController [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" STYLE="ROUNDED">
  <TR><TD BGCOLOR="#DBEAFE" ALIGN="CENTER"><B>AuthController</B><BR/><FONT POINT-SIZE="10">«controller»</FONT></TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#EFF6FF"><FONT POINT-SIZE="10">baseUrl: /api/auth</FONT></TD></TR>
  <TR><TD ALIGN="LEFT" BGCOLOR="#EFF6FF"><FONT POINT-SIZE="10">POST /register<BR ALIGN="LEFT"/>POST /login<BR ALIGN="LEFT"/>POST /logout</FONT></TD></TR>
</TABLE>
>];
    S_AuthService [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#334155" STYLE="ROUNDED">
  <TR><TD BGCOLOR="#DCFCE7" ALIGN="CENTER"><B>AuthService</B><BR/><FONT POINT-SIZE="10">«service interface»</FONT></TD></TR>
  
  
</TABLE>
>];
  }
  AuthController -> S_AuthService [label="调用", arrowhead=vee, color="#2563EB"];
